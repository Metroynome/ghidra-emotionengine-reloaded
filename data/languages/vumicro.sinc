VU0_CILW: is vu0_l_dx=1 & VU0_WIT { VU0_WIT = *[ram]:2 vu0_tr_ea; }
VU0_CILW: is vu0_l_dx=0 & vu0_l_dy=1 & VU0_WIT { VU0_WIT = *[ram]:2 (vu0_tr_ea + 4); }
