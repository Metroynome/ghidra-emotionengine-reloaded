VU1_CACCY: is vu1_u_dy=0 { }
VU1_CACCY: is vu1_u_dy=1 { vu1_acc_y = vu1_tr_y; }
VU1_CACCZ: is vu1_u_dz=0 { }
VU1_CACCZ: is vu1_u_dz=1 { vu1_acc_z = vu1_tr_z; }
VU1_CACCW: is vu1_u_dw=0 { }
VU1_CACCW: is vu1_u_dw=1 { vu1_acc_w = vu1_tr_w; }
VU1_CUFTX: is vu1_u_dx=0 { }
VU1_CUFTX: is vu1_u_dx=1 & VU1_WUFTX { VU1_WUFTX = vu1_tr_x; }
VU1_CUFTY: is vu1_u_dy=0 { }
