VU0_UBCV: is vu0_u_bc=1 { export vu0_ut_y; }
VU0_UBCV: is vu0_u_bc=2 { export vu0_ut_z; }
VU0_UBCV: is vu0_u_bc=3 { export vu0_ut_w; }

# The upper half's sources, taken before the lower half runs.
VU0_USNAP: is VU0_RUFSX & VU0_RUFTX & VU0_RUFSY & VU0_RUFTY & VU0_RUFSZ & VU0_RUFTZ & VU0_RUFSW & VU0_RUFTW {
	vu0_us_x = VU0_RUFSX;
	vu0_ut_x = VU0_RUFTX;
	vu0_us_y = VU0_RUFSY;
	vu0_ut_y = VU0_RUFTY;
	vu0_us_z = VU0_RUFSZ;
	vu0_ut_z = VU0_RUFTZ;
	vu0_us_w = VU0_RUFSW;
	vu0_ut_w = VU0_RUFTW;
	vu0_uq = vuQ;
	vu0_ui = vuI;
}

# Display operands.
VU0_UFD: vu0_u_fd^vu0_u_destn is vu0_u_fd & vu0_u_destn { }
VU0_UFS: vu0_u_fs^vu0_u_destn is vu0_u_fs & vu0_u_destn { }
VU0_UFT: vu0_u_ft^vu0_u_destn is vu0_u_ft & vu0_u_destn { }
VU0_UACC: "acc"^vu0_u_destn is vu0_u_destn { }
VU0_UBCR: vu0_u_ft^VU0_UBC is vu0_u_ft & VU0_UBC { }
VU0_LFT: vu0_l_ft^vu0_l_destn is vu0_l_ft & vu0_l_destn { }
VU0_LFS: vu0_l_fs^vu0_l_destn is vu0_l_fs & vu0_l_destn { }
VU0_IT: vu0_l_it is vu0_l_it { }
VU0_IS: vu0_l_is is vu0_l_is { }
VU0_ID: vu0_l_id is vu0_l_id { }
# The target is shown as the reference shows it; the PC wraps at the end of micro memory.
VU0_BTWRAP: wrapped is vu0_l_imm11 [ wrapped = (inst_next + vu0_l_imm11 * 8) & 0xfff; ] { export *:4 wrapped; }
VU0_BTARG: dest is vu0_l_imm11 & VU0_BTWRAP [ dest = inst_next + vu0_l_imm11 * 8; ] { export VU0_BTWRAP; }
VU0_IMM15: val is vu0_l_hi4 & vu0_l_lo11 [ val = (vu0_l_hi4 << 11) | vu0_l_lo11; ] { export *[const]:2 val; }
VU0_IMM12: val is vu0_l_bit21 & vu0_l_lo11 [ val = (vu0_l_bit21 << 11) | vu0_l_lo11; ] { export *[const]:2 val; }
VU0_UDMASK: val is vu0_u_dest [ val = vu0_u_dest * 0x1111; ] { export *[const]:4 val; }

# Lane commits: copy tr_<lane> to the destination when its dest bit is set.
VU0_CUFDX: is vu0_u_dx=0 { }
VU0_CUFDX: is vu0_u_dx=1 & VU0_WUFDX { VU0_WUFDX = vu0_tr_x; }
VU0_CUFDY: is vu0_u_dy=0 { }
VU0_CUFDY: is vu0_u_dy=1 & VU0_WUFDY { VU0_WUFDY = vu0_tr_y; }
