VU1_CLFTW: is vu1_l_dw=0 { }
VU1_CLFTW: is vu1_l_dw=1 & VU1_WLFTW { VU1_WLFTW = vu1_tr_w; }
VU1_CSTX: is vu1_l_dx=0 { }
VU1_CSTX: is vu1_l_dx=1 { *[ram]:4 (vu1_tr_ea + 0) = vu1_tr_x; }
VU1_CSTY: is vu1_l_dy=0 { }
VU1_CSTY: is vu1_l_dy=1 { *[ram]:4 (vu1_tr_ea + 4) = vu1_tr_y; }
VU1_CSTZ: is vu1_l_dz=0 { }
