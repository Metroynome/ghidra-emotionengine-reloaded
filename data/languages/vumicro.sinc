VU1_UBCV: is vu1_u_bc=1 { export vu1_ut_y; }
VU1_UBCV: is vu1_u_bc=2 { export vu1_ut_z; }
VU1_UBCV: is vu1_u_bc=3 { export vu1_ut_w; }

# The upper half's sources, taken before the lower half runs.
VU1_USNAP: is VU1_RUFSX & VU1_RUFTX & VU1_RUFSY & VU1_RUFTY & VU1_RUFSZ & VU1_RUFTZ & VU1_RUFSW & VU1_RUFTW {
	vu1_us_x = VU1_RUFSX;
	vu1_ut_x = VU1_RUFTX;
	vu1_us_y = VU1_RUFSY;
	vu1_ut_y = VU1_RUFTY;
	vu1_us_z = VU1_RUFSZ;
	vu1_ut_z = VU1_RUFTZ;
	vu1_us_w = VU1_RUFSW;
	vu1_ut_w = VU1_RUFTW;
	vu1_uq = vu1_q;
	vu1_ui = vu1_i;
}

# Display operands.
VU1_UFD: vu1_u_fd^vu1_u_destn is vu1_u_fd & vu1_u_destn { }
VU1_UFS: vu1_u_fs^vu1_u_destn is vu1_u_fs & vu1_u_destn { }
VU1_UFT: vu1_u_ft^vu1_u_destn is vu1_u_ft & vu1_u_destn { }
VU1_UACC: "acc"^vu1_u_destn is vu1_u_destn { }
VU1_UBCR: vu1_u_ft^VU1_UBC is vu1_u_ft & VU1_UBC { }
VU1_LFT: vu1_l_ft^vu1_l_destn is vu1_l_ft & vu1_l_destn { }
VU1_LFS: vu1_l_fs^vu1_l_destn is vu1_l_fs & vu1_l_destn { }
VU1_IT: vu1_l_it is vu1_l_it { }
VU1_IS: vu1_l_is is vu1_l_is { }
VU1_ID: vu1_l_id is vu1_l_id { }
# The target is shown as the reference shows it; the PC wraps at the end of micro memory.
VU1_BTWRAP: wrapped is vu1_l_imm11 [ wrapped = (inst_next + vu1_l_imm11 * 8) & 0x3fff; ] { export *:4 wrapped; }
VU1_BTARG: dest is vu1_l_imm11 & VU1_BTWRAP [ dest = inst_next + vu1_l_imm11 * 8; ] { export VU1_BTWRAP; }
VU1_IMM15: val is vu1_l_hi4 & vu1_l_lo11 [ val = (vu1_l_hi4 << 11) | vu1_l_lo11; ] { export *[const]:2 val; }
VU1_IMM12: val is vu1_l_bit21 & vu1_l_lo11 [ val = (vu1_l_bit21 << 11) | vu1_l_lo11; ] { export *[const]:2 val; }
VU1_UDMASK: val is vu1_u_dest [ val = vu1_u_dest * 0x1111; ] { export *[const]:4 val; }

# Lane commits: copy tr_<lane> to the destination when its dest bit is set.
VU1_CUFDX: is vu1_u_dx=0 { }
VU1_CUFDX: is vu1_u_dx=1 & VU1_WUFDX { VU1_WUFDX = vu1_tr_x; }
VU1_CUFDY: is vu1_u_dy=0 { }
VU1_CUFDY: is vu1_u_dy=1 & VU1_WUFDY { VU1_WUFDY = vu1_tr_y; }
VU1_CUFDZ: is vu1_u_dz=0 { }
VU1_CUFDZ: is vu1_u_dz=1 & VU1_WUFDZ { VU1_WUFDZ = vu1_tr_z; }
VU1_CUFDW: is vu1_u_dw=0 { }
VU1_CUFDW: is vu1_u_dw=1 & VU1_WUFDW { VU1_WUFDW = vu1_tr_w; }
