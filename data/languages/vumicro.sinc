# PlayStation 2 Vector Units, micro mode, inside the R5900 language. Generated by
# vu-tests/gen_slaspec.py; edit that. See gen_slaspec.py for the semantics.
#
# Microcode decodes where the context register VUMODE is 1 (VU0) or 2 (VU1); the EE core's own
# constructors require VUMODE 0. ImportVuMicrocode.java and the VU microcode analyzer place each
# microprogram in an overlay at its VU micro memory addresses and set VUMODE there. VU0 micro mode
# uses the COP2 registers that VU0 macro mode uses; VU1 has its own registers. Data memory is where
# the EE sees it: VU0's at 0x11004000, VU1's at 0x1100c000.

# The Elementary Function Unit's transcendental results and the GIF transfer have no p-code
# equivalent.
define pcodeop vu_sin;
define pcodeop vu_atan;
define pcodeop vu_exp;
define pcodeop vu_xgkick;

# ---- VU0 ----
define register offset=0x4000 size=2 [ vu0_vi00 _ vu0_vi01 _ vu0_vi02 _ vu0_vi03 _ vu0_vi04 _ vu0_vi05 _ vu0_vi06 _ vu0_vi07 _ vu0_vi08 _ vu0_vi09 _ vu0_vi10 _ vu0_vi11 _ vu0_vi12 _ vu0_vi13 _ vu0_vi14 _ vu0_vi15 _ ];
define register offset=0xa000 size=16 [ vu0_vfsink vu0_us vu0_ut ];
define register offset=0xa000 size=4 [ vu0_vfsink_x vu0_vfsink_y vu0_vfsink_z vu0_vfsink_w vu0_us_x vu0_us_y vu0_us_z vu0_us_w vu0_ut_x vu0_ut_y vu0_ut_z vu0_ut_w ];
define register offset=0xa800 size=2 [ vu0_vi16 vu0_vi17 vu0_vi18 vu0_vi19 vu0_vi20 vu0_vi21 vu0_vi22 vu0_vi23 vu0_vi24 vu0_vi25 vu0_vi26 vu0_vi27 vu0_vi28 vu0_vi29 vu0_vi30 vu0_vi31 vu0_visink ];
define register offset=0xa900 size=4 [ vu0_uq vu0_ui vu0_lbr_target vu0_vu_end vu0_tr_x vu0_tr_y vu0_tr_z vu0_tr_w vu0_tr_ea vu0_vu_sp ];
define register offset=0xaa00 size=2 [ vu0_vu_top vu0_vu_itop ];
define register offset=0xab00 size=1 [ vu0_lbr_cond ];
define token vu0_instr(64)
	# Lower instruction (first word).
	vu0_l_word = (0,31)
	vu0_l_op7 = (25,31)
	vu0_l_dest = (21,24)
	vu0_l_dx = (24,24)
	vu0_l_dy = (23,23)
	vu0_l_dz = (22,22)
	vu0_l_dw = (21,21)
	vu0_l_ft = (16,20)
	vu0_l_fs = (11,15)
	vu0_l_fd = (6,10)
	vu0_l_it = (16,20)
	vu0_l_is = (11,15)
	vu0_l_id = (6,10)
	vu0_l_op6 = (0,5)
	vu0_l_op11 = (0,10)
	vu0_l_fsf = (21,22)
	vu0_l_ftf = (23,24)
	vu0_l_imm11 = (0,10) signed dec
	vu0_l_imm5 = (6,10) signed dec
	vu0_l_lo11 = (0,10)
	vu0_l_hi4 = (21,24)
	vu0_l_bit21 = (21,21)
	vu0_l_imm24 = (0,23) dec
	vu0_l_b24 = (24,24)
	vu0_l_hi3 = (22,24)
	# The flags and dest masks again, as named fields for display (see the Display section).
	vu0_u_flagsn = (59,63)
	vu0_u_destn = (53,56)
	vu0_l_destn = (21,24)
	vu0_l_destn2 = (21,24)
	vu0_l_lo6 = (0,5)
	# Upper instruction (second word).
	vu0_u_word = (32,63)
	vu0_u_flags = (59,63)
	vu0_u_i = (63,63)
	vu0_u_e = (62,62)
	vu0_u_res = (57,58)
	vu0_u_dest = (53,56)
	vu0_u_dx = (56,56)
	vu0_u_dy = (55,55)
	vu0_u_dz = (54,54)
	vu0_u_dw = (53,53)
	vu0_u_ft = (48,52)
	vu0_u_fs = (43,47)
	vu0_u_fd = (38,42)
	vu0_u_op6 = (32,37)
	vu0_u_op4 = (34,37)
	vu0_u_bc = (32,33)
	vu0_u_op11 = (32,42)
	# The VI register fields again, for semantics; the fields above are for display.
	vu0_l_itv = (16,20)
	vu0_l_isv = (11,15)
	vu0_l_idv = (6,10)
	vu0_l_ftx = (16,20)
	vu0_l_fty = (16,20)
	vu0_l_ftz = (16,20)
	vu0_l_ftw = (16,20)
	vu0_l_fsx = (11,15)
	vu0_l_fsy = (11,15)
	vu0_l_fsz = (11,15)
	vu0_l_fsw = (11,15)
	vu0_u_ftx = (48,52)
	vu0_u_fty = (48,52)
	vu0_u_ftz = (48,52)
	vu0_u_ftw = (48,52)
	vu0_u_fsx = (43,47)
	vu0_u_fsy = (43,47)
	vu0_u_fsz = (43,47)
	vu0_u_fsw = (43,47)
	vu0_u_fdx = (38,42)
	vu0_u_fdy = (38,42)
	vu0_u_fdz = (38,42)
	vu0_u_fdw = (38,42)
;

