VU1_CUFTZ: is vu1_u_dz=0 { }
VU1_CUFTZ: is vu1_u_dz=1 & VU1_WUFTZ { VU1_WUFTZ = vu1_tr_z; }
VU1_CUFTW: is vu1_u_dw=0 { }
VU1_CUFTW: is vu1_u_dw=1 & VU1_WUFTW { VU1_WUFTW = vu1_tr_w; }
VU1_CILW: is vu1_l_dx=1 & VU1_WIT { VU1_WIT = *[ram]:2 vu1_tr_ea; }
VU1_CILW: is vu1_l_dx=0 & vu1_l_dy=1 & VU1_WIT { VU1_WIT = *[ram]:2 (vu1_tr_ea + 4); }
VU1_CILW: is vu1_l_dx=0 & vu1_l_dy=0 & vu1_l_dz=1 & VU1_WIT { VU1_WIT = *[ram]:2 (vu1_tr_ea + 8); }
VU1_CILW: is vu1_l_dx=0 & vu1_l_dy=0 & vu1_l_dz=0 & vu1_l_dw=1 & VU1_WIT { VU1_WIT = *[ram]:2 (vu1_tr_ea + 12); }
VU1_CILW: is vu1_l_dest=0 { }
VU1_CLFTX: is vu1_l_dx=0 { }
VU1_CLFTX: is vu1_l_dx=1 & VU1_WLFTX { VU1_WLFTX = vu1_tr_x; }
VU1_CLFTY: is vu1_l_dy=0 { }
