VU1_CSTW: is vu1_l_dw=0 { }
VU1_CSTW: is vu1_l_dw=1 { *[ram]:4 (vu1_tr_ea + 12) = vu1_tr_w; }

# Upper instructions. The vu1_u_res bits are always clear.
VU1_UPPER: "add"^VU1_UBC^vu1_u_flagsn^"."^vu1_u_destn VU1_UFD^","^VU1_UFS^","^VU1_UBCR is vu1_u_op4=0 & vu1_u_res=0 & vu1_u_flagsn & vu1_u_destn & VU1_CUFDW & VU1_CUFDX & VU1_CUFDY & VU1_CUFDZ & VU1_UBC & VU1_UBCR & VU1_UBCV & VU1_UDMASK & VU1_UFD & VU1_UFS {
	local r_x:4 = vu1_us_x f+ VU1_UBCV;
	local r_y:4 = vu1_us_y f+ VU1_UBCV;
	local r_z:4 = vu1_us_z f+ VU1_UBCV;
	local r_w:4 = vu1_us_w f+ VU1_UBCV;
	local e_x:4 = (r_x >> 23) & 0xff;
	local o_x:4 = zext(e_x == 0xff);
	local u_x:4 = zext((e_x == 0) && ((r_x & 0x7fffff) != 0));
	local e_y:4 = (r_y >> 23) & 0xff;
	local o_y:4 = zext(e_y == 0xff);
	local u_y:4 = zext((e_y == 0) && ((r_y & 0x7fffff) != 0));
	local e_z:4 = (r_z >> 23) & 0xff;
	local o_z:4 = zext(e_z == 0xff);
	local u_z:4 = zext((e_z == 0) && ((r_z & 0x7fffff) != 0));
	local e_w:4 = (r_w >> 23) & 0xff;
	local o_w:4 = zext(e_w == 0xff);
	local u_w:4 = zext((e_w == 0) && ((r_w & 0x7fffff) != 0));
	local fl:4 = ((zext(((r_x & 0x7fffffff) == 0) || (u_x != 0)) << 3) | ((r_x >> 31) << 7) | (u_x << 11) | (o_x << 15) | (zext(((r_y & 0x7fffffff) == 0) || (u_y != 0)) << 2) | ((r_y >> 31) << 6) | (u_y << 10) | (o_y << 14) | (zext(((r_z & 0x7fffffff) == 0) || (u_z != 0)) << 1) | ((r_z >> 31) << 5) | (u_z << 9) | (o_z << 13) | (zext(((r_w & 0x7fffffff) == 0) || (u_w != 0)) << 0) | ((r_w >> 31) << 4) | (u_w << 8) | (o_w << 12)) & VU1_UDMASK;
	vu1_mac = fl;
