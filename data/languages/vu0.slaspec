UF: "[iemdt]" is u_flags=31 { }
UBC: "x" is u_bc=0 { }
UBC: "y" is u_bc=1 { }
UBC: "z" is u_bc=2 { }
UBC: "w" is u_bc=3 { }
LFSF: "x" is l_fsf=0 { }
LFSF: "y" is l_fsf=1 { }
LFSF: "z" is l_fsf=2 { }
LFSF: "w" is l_fsf=3 { }
LFTF: "x" is l_ftf=0 { }
LFTF: "y" is l_ftf=1 { }
LFTF: "z" is l_ftf=2 { }
LFTF: "w" is l_ftf=3 { }

# Reads: vf00 is (0, 0, 0, 1.0) and vi00 is 0.
RLFTX: is l_ft=0 { export 0:4; }
RLFTX: is l_ftx { export l_ftx; }
RLFTY: is l_ft=0 { export 0:4; }
RLFTY: is l_fty { export l_fty; }
RLFTZ: is l_ft=0 { export 0:4; }
RLFTZ: is l_ftz { export l_ftz; }
RLFTW: is l_ft=0 { export 0x3f800000:4; }
RLFTW: is l_ftw { export l_ftw; }
RLFSX: is l_fs=0 { export 0:4; }
RLFSX: is l_fsx { export l_fsx; }
RLFSY: is l_fs=0 { export 0:4; }
RLFSY: is l_fsy { export l_fsy; }
RLFSZ: is l_fs=0 { export 0:4; }
RLFSZ: is l_fsz { export l_fsz; }
RLFSW: is l_fs=0 { export 0x3f800000:4; }
RLFSW: is l_fsw { export l_fsw; }
RUFTX: is u_ft=0 { export 0:4; }
RUFTX: is u_ftx { export u_ftx; }
RUFTY: is u_ft=0 { export 0:4; }
RUFTY: is u_fty { export u_fty; }
RUFTZ: is u_ft=0 { export 0:4; }
RUFTZ: is u_ftz { export u_ftz; }
RUFTW: is u_ft=0 { export 0x3f800000:4; }
RUFTW: is u_ftw { export u_ftw; }
RUFSX: is u_fs=0 { export 0:4; }
RUFSX: is u_fsx { export u_fsx; }
RUFSY: is u_fs=0 { export 0:4; }
RUFSY: is u_fsy { export u_fsy; }
RUFSZ: is u_fs=0 { export 0:4; }
RUFSZ: is u_fsz { export u_fsz; }
RUFSW: is u_fs=0 { export 0x3f800000:4; }
RUFSW: is u_fsw { export u_fsw; }
# Writes to vf00 and vi00 are discarded.
WLFTX: is l_ft=0 { export vfsink_x; }
WLFTX: is l_ftx { export l_ftx; }
WLFTY: is l_ft=0 { export vfsink_y; }
WLFTY: is l_fty { export l_fty; }
WLFTZ: is l_ft=0 { export vfsink_z; }
WLFTZ: is l_ftz { export l_ftz; }
WLFTW: is l_ft=0 { export vfsink_w; }
WLFTW: is l_ftw { export l_ftw; }
WUFTX: is u_ft=0 { export vfsink_x; }
WUFTX: is u_ftx { export u_ftx; }
WUFTY: is u_ft=0 { export vfsink_y; }
WUFTY: is u_fty { export u_fty; }
WUFTZ: is u_ft=0 { export vfsink_z; }
WUFTZ: is u_ftz { export u_ftz; }
WUFTW: is u_ft=0 { export vfsink_w; }
WUFTW: is u_ftw { export u_ftw; }
WUFDX: is u_fd=0 { export vfsink_x; }
WUFDX: is u_fdx { export u_fdx; }
WUFDY: is u_fd=0 { export vfsink_y; }
WUFDY: is u_fdy { export u_fdy; }
WUFDZ: is u_fd=0 { export vfsink_z; }
WUFDZ: is u_fdz { export u_fdz; }
WUFDW: is u_fd=0 { export vfsink_w; }
WUFDW: is u_fdw { export u_fdw; }
RIT: is l_it=0 { export 0:2; }
RIT: is l_it { export l_it; }
WIT: is l_it=0 { export visink; }
WIT: is l_it { export l_it; }
RIS: is l_is=0 { export 0:2; }
RIS: is l_is { export l_is; }
WIS: is l_is=0 { export visink; }
WIS: is l_is { export l_is; }
RID: is l_id=0 { export 0:2; }
RID: is l_id { export l_id; }
WID: is l_id=0 { export visink; }
WID: is l_id { export l_id; }
RLFSF: is l_fsf=0 & RLFSX { export RLFSX; }
RLFSF: is l_fsf=1 & RLFSY { export RLFSY; }
RLFSF: is l_fsf=2 & RLFSZ { export RLFSZ; }
RLFSF: is l_fsf=3 & RLFSW { export RLFSW; }
RLFTF: is l_ftf=0 & RLFTX { export RLFTX; }
RLFTF: is l_ftf=1 & RLFTY { export RLFTY; }
RLFTF: is l_ftf=2 & RLFTZ { export RLFTZ; }
RLFTF: is l_ftf=3 & RLFTW { export RLFTW; }
UBCV: is u_bc=0 { export ut_x; }
UBCV: is u_bc=1 { export ut_y; }
UBCV: is u_bc=2 { export ut_z; }
UBCV: is u_bc=3 { export ut_w; }

# The upper half's sources, taken before the lower half runs.
USNAP: is RUFSX & RUFTX & RUFSY & RUFTY & RUFSZ & RUFTZ & RUFSW & RUFTW {
	us_x = RUFSX;
	ut_x = RUFTX;
	us_y = RUFSY;
	ut_y = RUFTY;
	us_z = RUFSZ;
	ut_z = RUFTZ;
	us_w = RUFSW;
	ut_w = RUFTW;
	uq = q;
	ui = i;
}

# Display operands.
UFD: u_fd^UD is u_fd & UD { }
UFS: u_fs^UD is u_fs & UD { }
UFT: u_ft^UD is u_ft & UD { }
UACC: "acc"^UD is UD { }
UBCR: u_ft^UBC is u_ft & UBC { }
LFT: l_ft^LD is l_ft & LD { }
LFS: l_fs^LD is l_fs & LD { }
IT: l_it is l_it { }
IS: l_is is l_is { }
ID: l_id is l_id { }
# The target is shown as the reference shows it; the PC wraps at the end of micro memory.
BTWRAP: wrapped is l_imm11 [ wrapped = (inst_next + l_imm11 * 8) & 0xfff; ] { export *:4 wrapped; }
BTARG: dest is l_imm11 & BTWRAP [ dest = inst_next + l_imm11 * 8; ] { export BTWRAP; }
IMM15: val is l_hi4 & l_lo11 [ val = (l_hi4 << 11) | l_lo11; ] { export *[const]:2 val; }
IMM12: val is l_bit21 & l_lo11 [ val = (l_bit21 << 11) | l_lo11; ] { export *[const]:2 val; }
UDMASK: val is u_dest [ val = u_dest * 0x1111; ] { export *[const]:4 val; }

# Lane commits: copy tr_<lane> to the destination when its dest bit is set.
CUFDX: is u_dx=0 { }
CUFDX: is u_dx=1 & WUFDX { WUFDX = tr_x; }
CUFDY: is u_dy=0 { }
CUFDY: is u_dy=1 & WUFDY { WUFDY = tr_y; }
CUFDZ: is u_dz=0 { }
CUFDZ: is u_dz=1 & WUFDZ { WUFDZ = tr_z; }
CUFDW: is u_dw=0 { }
CUFDW: is u_dw=1 & WUFDW { WUFDW = tr_w; }
CACCX: is u_dx=0 { }
CACCX: is u_dx=1 { acc_x = tr_x; }
CACCY: is u_dy=0 { }
CACCY: is u_dy=1 { acc_y = tr_y; }
CACCZ: is u_dz=0 { }
CACCZ: is u_dz=1 { acc_z = tr_z; }
CACCW: is u_dw=0 { }
CACCW: is u_dw=1 { acc_w = tr_w; }
CUFTX: is u_dx=0 { }
CUFTX: is u_dx=1 & WUFTX { WUFTX = tr_x; }
CUFTY: is u_dy=0 { }
CUFTY: is u_dy=1 & WUFTY { WUFTY = tr_y; }
CUFTZ: is u_dz=0 { }
CUFTZ: is u_dz=1 & WUFTZ { WUFTZ = tr_z; }
CUFTW: is u_dw=0 { }
CUFTW: is u_dw=1 & WUFTW { WUFTW = tr_w; }
CILW: is l_dx=1 & WIT { WIT = *[vumem]:2 tr_ea; }
CILW: is l_dx=0 & l_dy=1 & WIT { WIT = *[vumem]:2 (tr_ea + 4); }
CILW: is l_dx=0 & l_dy=0 & l_dz=1 & WIT { WIT = *[vumem]:2 (tr_ea + 8); }
CILW: is l_dx=0 & l_dy=0 & l_dz=0 & l_dw=1 & WIT { WIT = *[vumem]:2 (tr_ea + 12); }
CILW: is l_dest=0 { }
CLFTX: is l_dx=0 { }
CLFTX: is l_dx=1 & WLFTX { WLFTX = tr_x; }
CLFTY: is l_dy=0 { }
CLFTY: is l_dy=1 & WLFTY { WLFTY = tr_y; }
CLFTZ: is l_dz=0 { }
CLFTZ: is l_dz=1 & WLFTZ { WLFTZ = tr_z; }
CLFTW: is l_dw=0 { }
CLFTW: is l_dw=1 & WLFTW { WLFTW = tr_w; }
CSTX: is l_dx=0 { }
CSTX: is l_dx=1 { *[vumem]:4 (tr_ea + 0) = tr_x; }
CSTY: is l_dy=0 { }
CSTY: is l_dy=1 { *[vumem]:4 (tr_ea + 4) = tr_y; }
CSTZ: is l_dz=0 { }
CSTZ: is l_dz=1 { *[vumem]:4 (tr_ea + 8) = tr_z; }
CSTW: is l_dw=0 { }
CSTW: is l_dw=1 { *[vumem]:4 (tr_ea + 12) = tr_w; }

# Upper instructions. The u_res bits are always clear.
UPPER: "add"^UBC^UF^"."^UD UFD^","^UFS^","^UBCR is u_op4=0 & u_res=0 & UF & UD & CUFDW & CUFDX & CUFDY & CUFDZ & UBC & UBCR & UBCV & UDMASK & UFD & UFS {
	local r_x:4 = us_x f+ UBCV;
	local r_y:4 = us_y f+ UBCV;
	local r_z:4 = us_z f+ UBCV;
	local r_w:4 = us_w f+ UBCV;
	local e_x:4 = (r_x >> 23) & 0xff;
	local o_x:4 = zext(e_x == 0xff);
	local u_x:4 = zext((e_x == 0) && ((r_x & 0x7fffff) != 0));
	local e_y:4 = (r_y >> 23) & 0xff;
	local o_y:4 = zext(e_y == 0xff);
	local u_y:4 = zext((e_y == 0) && ((r_y & 0x7fffff) != 0));
