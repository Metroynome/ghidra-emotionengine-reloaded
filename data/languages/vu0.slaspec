}
UPPER: "itof15"^UF^"."^UD UFT^","^UFS is u_op11=0x13f & u_res=0 & UF & UD & CUFTW & CUFTX & CUFTY & CUFTZ & UFS & UFT {
	tr_x = int2float(us_x) f/ int2float(32768:4);
	tr_y = int2float(us_y) f/ int2float(32768:4);
