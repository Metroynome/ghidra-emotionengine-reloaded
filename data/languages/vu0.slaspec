UPPER: "ftoi15"^UF^"."^UD UFT^","^UFS is u_op11=0x17f & u_res=0 & UF & UD & CUFTW & CUFTX & CUFTY & CUFTZ & UFS & UFT {
	tr_x = trunc(us_x f* int2float(32768:4));
	tr_y = trunc(us_y f* int2float(32768:4));
	tr_z = trunc(us_z f* int2float(32768:4));
