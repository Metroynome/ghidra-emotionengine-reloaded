UPPER: "clipw"^UF^"."^UD UFS^","^u_ft^"w" is u_op11=0x1ff & u_dest=0xe & u_res=0 & UF & UD & UFS & u_ft {
	local lim:4 = abs(ut_w);
	local bits:4 = 0;
	bits = bits | (zext(us_x f> lim) << 0);
	bits = bits | (zext(us_x f< f- lim) << 1);
	bits = bits | (zext(us_y f> lim) << 2);
	bits = bits | (zext(us_y f< f- lim) << 3);
	bits = bits | (zext(us_z f> lim) << 4);
	bits = bits | (zext(us_z f< f- lim) << 5);
	clip = ((clip << 6) | bits) & 0xffffff;
}
UPPER: "nop"^UF is u_op11=0x2ff & u_res=0 & u_dest=0 & u_ft=0 & u_fs=0 & UF { }
# The reference decodes each half on its own and shows an invalid half as *unknown*.
UPPER: "*unknown*" is u_word { }

# Lower instructions.
LOWER: "lq."^LD LFT^","^l_imm11^"("^IS^")" is l_op7=0x0 & CLFTW & CLFTX & CLFTY & CLFTZ & IS & LD & LFT & RIS & l_imm11 {
	local qa:2 = (RIS + l_imm11) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = *[vumem]:4 (tr_ea + 0);
	tr_y = *[vumem]:4 (tr_ea + 4);
	tr_z = *[vumem]:4 (tr_ea + 8);
	tr_w = *[vumem]:4 (tr_ea + 12);
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "sq."^LD LFS^","^l_imm11^"("^IT^")" is l_op7=0x1 & CSTW & CSTX & CSTY & CSTZ & IT & LD & LFS & RIT & RLFSW & RLFSX & RLFSY & RLFSZ & l_imm11 {
	local qa:2 = (RIT + l_imm11) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = RLFSX;
	tr_y = RLFSY;
	tr_z = RLFSZ;
	tr_w = RLFSW;
	build CSTX;
	build CSTY;
	build CSTZ;
	build CSTW;
}
LOWER: "ilw."^LD IT^","^l_imm11^"("^IS^")"^LD2 is l_op7=0x4 & CILW & IS & IT & LD & LD2 & RIS & l_imm11 {
	local qa:2 = (RIS + l_imm11) & 0xff;
	tr_ea = zext(qa) * 16;
	build CILW;
}
LOWER: "isw."^LD IT^","^l_imm11^"("^IS^")"^LD2 is l_op7=0x5 & CSTW & CSTX & CSTY & CSTZ & IS & IT & LD & LD2 & RIS & RIT & l_imm11 {
	local qa:2 = (RIS + l_imm11) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = zext(RIT);
	tr_y = zext(RIT);
	tr_z = zext(RIT);
	tr_w = zext(RIT);
	build CSTX;
	build CSTY;
	build CSTZ;
	build CSTW;
}
LOWER: "iaddiu" IT^","^IS^","^IMM15 is l_op7=0x8 & IMM15 & IS & IT & RIS & WIT {
	WIT = RIS + IMM15;
}
LOWER: "isubiu" IT^","^IS^","^IMM15 is l_op7=0x9 & IMM15 & IS & IT & RIS & WIT {
	WIT = RIS - IMM15;
}
LOWER: "fceq vi01,"^l_imm24 is l_op7=0x10 & l_imm24 & l_b24=0 {
	vi01 = zext((clip & 0xffffff) == l_imm24);
}
LOWER: "fcset" l_imm24 is l_op7=0x11 & l_imm24 & l_b24=0 {
	clip = l_imm24;
}
LOWER: "fcand vi01,"^l_imm24 is l_op7=0x12 & l_imm24 & l_b24=0 {
	vi01 = zext((clip & l_imm24) != 0);
}
LOWER: "fcor vi01,"^l_imm24 is l_op7=0x13 & l_imm24 & l_b24=0 {
	vi01 = zext(((clip | l_imm24) & 0xffffff) == 0xffffff);
}
LOWER: "fseq" IT^","^IMM12 is l_op7=0x14 & IMM12 & IT & WIT & l_hi3=0 & l_is=0 {
	WIT = zext((status:2 & 0xfff) == IMM12);
}
LOWER: "fsset" IMM12 is l_op7=0x15 & IMM12 & l_hi3=0 & l_it=0 & l_is=0 & l_lo6=0 {
	status = (status & 0x3f) | (zext(IMM12) & 0xfc0);
}
LOWER: "fsand" IT^","^IMM12 is l_op7=0x16 & IMM12 & IT & WIT & l_hi3=0 & l_is=0 {
	WIT = status:2 & IMM12;
}
LOWER: "fsor" IT^","^IMM12 is l_op7=0x17 & IMM12 & IT & WIT & l_hi3=0 & l_is=0 {
	WIT = (status:2 | IMM12) & 0xfff;
}
LOWER: "fmeq" IT^","^IS is l_op7=0x18 & IS & IT & RIS & WIT & l_dest=0 & l_lo11=0 {
	WIT = zext(mac:2 == RIS);
}
LOWER: "fmand" IT^","^IS is l_op7=0x1a & IS & IT & RIS & WIT & l_dest=0 & l_lo11=0 {
	WIT = mac:2 & RIS;
}
LOWER: "fmor" IT^","^IS is l_op7=0x1b & IS & IT & RIS & WIT & l_dest=0 & l_lo11=0 {
	WIT = mac:2 | RIS;
}
LOWER: "fcget" IT is l_op7=0x1c & IT & WIT & l_dest=0 & l_is=0 & l_lo11=0 {
	WIT = clip:2 & 0xfff;
}
LOWER: "iadd" ID^","^IS^","^IT is l_op7=0x40 & l_op6=0x30 & ID & IS & IT & RIS & RIT & WID & l_dest=0 {
	WID = RIS + RIT;
}
LOWER: "isub" ID^","^IS^","^IT is l_op7=0x40 & l_op6=0x31 & ID & IS & IT & RIS & RIT & WID & l_dest=0 {
	WID = RIS - RIT;
}
LOWER: "iaddi" IT^","^IS^","^l_imm5 is l_op7=0x40 & l_op6=0x32 & IS & IT & RIS & WIT & l_imm5 & l_dest=0 {
	WIT = RIS + l_imm5;
}
LOWER: "iand" ID^","^IS^","^IT is l_op7=0x40 & l_op6=0x34 & ID & IS & IT & RIS & RIT & WID & l_dest=0 {
	WID = RIS & RIT;
