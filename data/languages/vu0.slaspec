# PlayStation 2 Vector Unit (VU0), micro mode. Generated by vu-tests/gen_slaspec.py; edit that.
#
# Each instruction is 64 bits: the lower instruction is the first word in memory and the upper
# instruction the second. The listing follows PS2SDK dvp-objdump: "upper<tab>lower". Branch
# offsets count 64-bit words from the next instruction. See gen_slaspec.py for the semantics.

define endian=little;
define alignment=8;

define space ram type=ram_space size=4 default;
define space vumem type=ram_space size=4;
define space register type=register_space size=4;

define register offset=0x0 size=4 [ pc ];

define register offset=0x1000 size=16 [ vf00 vf01 vf02 vf03 vf04 vf05 vf06 vf07 vf08 vf09 vf10 vf11 vf12 vf13 vf14 vf15 vf16 vf17 vf18 vf19 vf20 vf21 vf22 vf23 vf24 vf25 vf26 vf27 vf28 vf29 vf30 vf31 acc vfsink us ut ];
define register offset=0x1000 size=4 [ vf00_x vf00_y vf00_z vf00_w vf01_x vf01_y vf01_z vf01_w vf02_x vf02_y vf02_z vf02_w vf03_x vf03_y vf03_z vf03_w vf04_x vf04_y vf04_z vf04_w vf05_x vf05_y vf05_z vf05_w vf06_x vf06_y vf06_z vf06_w vf07_x vf07_y vf07_z vf07_w vf08_x vf08_y vf08_z vf08_w vf09_x vf09_y vf09_z vf09_w vf10_x vf10_y vf10_z vf10_w vf11_x vf11_y vf11_z vf11_w vf12_x vf12_y vf12_z vf12_w vf13_x vf13_y vf13_z vf13_w vf14_x vf14_y vf14_z vf14_w vf15_x vf15_y vf15_z vf15_w vf16_x vf16_y vf16_z vf16_w vf17_x vf17_y vf17_z vf17_w vf18_x vf18_y vf18_z vf18_w vf19_x vf19_y vf19_z vf19_w vf20_x vf20_y vf20_z vf20_w vf21_x vf21_y vf21_z vf21_w vf22_x vf22_y vf22_z vf22_w vf23_x vf23_y vf23_z vf23_w vf24_x vf24_y vf24_z vf24_w vf25_x vf25_y vf25_z vf25_w vf26_x vf26_y vf26_z vf26_w vf27_x vf27_y vf27_z vf27_w vf28_x vf28_y vf28_z vf28_w vf29_x vf29_y vf29_z vf29_w vf30_x vf30_y vf30_z vf30_w vf31_x vf31_y vf31_z vf31_w acc_x acc_y acc_z acc_w vfsink_x vfsink_y vfsink_z vfsink_w us_x us_y us_z us_w ut_x ut_y ut_z ut_w ];
# The hardware has 16 VI registers; the 5-bit fields also decode vi16-vi31, as the reference does.
define register offset=0x2000 size=2 [ vi00 vi01 vi02 vi03 vi04 vi05 vi06 vi07 vi08 vi09 vi10 vi11 vi12 vi13 vi14 vi15 vi16 vi17 vi18 vi19 vi20 vi21 vi22 vi23 vi24 vi25 vi26 vi27 vi28 vi29 vi30 vi31 visink ];
define register offset=0x3000 size=4 [ q p i r status mac clip uq ui lbr_target vu_end tr_x tr_y tr_z tr_w tr_ea vu_sp ];
define register offset=0x3100 size=2 [ vu_top vu_itop ];
define register offset=0x3200 size=1 [ lbr_cond ];
define register offset=0x3300 size=4 [ contextreg ];
# Set on the instruction after one with the E bit: it ends the program once it has run.
define context contextreg endslot = (0,0) noflow;

# The Elementary Function Unit's transcendental results, the random number generator's next value
# and the GIF transfer have no p-code equivalent.
define pcodeop vu_sin;
define pcodeop vu_atan;
define pcodeop vu_exp;
define pcodeop vu_xgkick;

define token instr(64)
	# Lower instruction (first word).
	l_word = (0,31)
	l_op7 = (25,31)
	l_dest = (21,24)
	l_dx = (24,24)
	l_dy = (23,23)
	l_dz = (22,22)
	l_dw = (21,21)
	l_ft = (16,20)
	l_fs = (11,15)
	l_fd = (6,10)
	l_it = (16,20)
	l_is = (11,15)
	l_id = (6,10)
	l_op6 = (0,5)
	l_op11 = (0,10)
	l_fsf = (21,22)
	l_ftf = (23,24)
	l_imm11 = (0,10) signed dec
	l_imm5 = (6,10) signed dec
	l_lo11 = (0,10)
	l_hi4 = (21,24)
	l_bit21 = (21,21)
	l_imm24 = (0,23) dec
	l_b24 = (24,24)
	l_hi3 = (22,24)
	l_lo6 = (0,5)
	# Upper instruction (second word).
	u_word = (32,63)
	u_flags = (59,63)
	u_i = (63,63)
	u_e = (62,62)
	u_res = (57,58)
	u_dest = (53,56)
	u_dx = (56,56)
	u_dy = (55,55)
	u_dz = (54,54)
	u_dw = (53,53)
	u_ft = (48,52)
	u_fs = (43,47)
	u_fd = (38,42)
	u_op6 = (32,37)
	u_op4 = (34,37)
	u_bc = (32,33)
	u_op11 = (32,42)
	l_ftx = (16,20)
	l_fty = (16,20)
	l_ftz = (16,20)
	l_ftw = (16,20)
	l_fsx = (11,15)
	l_fsy = (11,15)
	l_fsz = (11,15)
	l_fsw = (11,15)
	u_ftx = (48,52)
	u_fty = (48,52)
	u_ftz = (48,52)
	u_ftw = (48,52)
	u_fsx = (43,47)
	u_fsy = (43,47)
	u_fsz = (43,47)
	u_fsw = (43,47)
	u_fdx = (38,42)
	u_fdy = (38,42)
	u_fdz = (38,42)
	u_fdw = (38,42)
;

attach variables [ l_ft l_fs l_fd u_ft u_fs u_fd ] [ vf00 vf01 vf02 vf03 vf04 vf05 vf06 vf07 vf08 vf09 vf10 vf11 vf12 vf13 vf14 vf15 vf16 vf17 vf18 vf19 vf20 vf21 vf22 vf23 vf24 vf25 vf26 vf27 vf28 vf29 vf30 vf31 ];
attach variables [ l_it l_is l_id ] [ vi00 vi01 vi02 vi03 vi04 vi05 vi06 vi07 vi08 vi09 vi10 vi11 vi12 vi13 vi14 vi15 vi16 vi17 vi18 vi19 vi20 vi21 vi22 vi23 vi24 vi25 vi26 vi27 vi28 vi29 vi30 vi31 ];
attach variables [ l_ftx l_fsx u_ftx u_fsx u_fdx ] [ vf00_x vf01_x vf02_x vf03_x vf04_x vf05_x vf06_x vf07_x vf08_x vf09_x vf10_x vf11_x vf12_x vf13_x vf14_x vf15_x vf16_x vf17_x vf18_x vf19_x vf20_x vf21_x vf22_x vf23_x vf24_x vf25_x vf26_x vf27_x vf28_x vf29_x vf30_x vf31_x ];
attach variables [ l_fty l_fsy u_fty u_fsy u_fdy ] [ vf00_y vf01_y vf02_y vf03_y vf04_y vf05_y vf06_y vf07_y vf08_y vf09_y vf10_y vf11_y vf12_y vf13_y vf14_y vf15_y vf16_y vf17_y vf18_y vf19_y vf20_y vf21_y vf22_y vf23_y vf24_y vf25_y vf26_y vf27_y vf28_y vf29_y vf30_y vf31_y ];
attach variables [ l_ftz l_fsz u_ftz u_fsz u_fdz ] [ vf00_z vf01_z vf02_z vf03_z vf04_z vf05_z vf06_z vf07_z vf08_z vf09_z vf10_z vf11_z vf12_z vf13_z vf14_z vf15_z vf16_z vf17_z vf18_z vf19_z vf20_z vf21_z vf22_z vf23_z vf24_z vf25_z vf26_z vf27_z vf28_z vf29_z vf30_z vf31_z ];
attach variables [ l_ftw l_fsw u_ftw u_fsw u_fdw ] [ vf00_w vf01_w vf02_w vf03_w vf04_w vf05_w vf06_w vf07_w vf08_w vf09_w vf10_w vf11_w vf12_w vf13_w vf14_w vf15_w vf16_w vf17_w vf18_w vf19_w vf20_w vf21_w vf22_w vf23_w vf24_w vf25_w vf26_w vf27_w vf28_w vf29_w vf30_w vf31_w ];

