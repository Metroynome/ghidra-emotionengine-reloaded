LOWER: "esadd p,"^l_fs is l_op7=0x40 & l_op11=0x73c & RLFSX & RLFSY & RLFSZ & l_fs & l_dest=0xe & l_ft=0 {
	p = (RLFSX f* RLFSX) f+ (RLFSY f* RLFSY) f+ (RLFSZ f* RLFSZ);
}
LOWER: "ersadd p,"^l_fs is l_op7=0x40 & l_op11=0x73d & RLFSX & RLFSY & RLFSZ & l_fs & l_dest=0xe & l_ft=0 {
	p = int2float(1:4) f/ ((RLFSX f* RLFSX) f+ (RLFSY f* RLFSY) f+ (RLFSZ f* RLFSZ));
}
LOWER: "eleng p,"^l_fs is l_op7=0x40 & l_op11=0x73e & RLFSX & RLFSY & RLFSZ & l_fs & l_dest=0xe & l_ft=0 {
	p = sqrt((RLFSX f* RLFSX) f+ (RLFSY f* RLFSY) f+ (RLFSZ f* RLFSZ));
