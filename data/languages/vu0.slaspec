}
LOWER: "iswr."^LD IT^",("^IS^")"^LD2 is l_op7=0x40 & l_op11=0x3ff & CSTW & CSTX & CSTY & CSTZ & IS & IT & LD & LD2 & RIS & RIT {
	local qa:2 = (RIS) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = zext(RIT);
	tr_y = zext(RIT);
	tr_z = zext(RIT);
	tr_w = zext(RIT);
	build CSTX;
	build CSTY;
	build CSTZ;
	build CSTW;
}
LOWER: "rnext."^LD LFT^",r" is l_op7=0x40 & l_op11=0x43c & CLFTW & CLFTX & CLFTY & CLFTZ & LD & LFT & l_is=0 {
	local fb:4 = ((r >> 4) ^ (r >> 22)) & 1;
	r = (((r << 1) ^ fb) & 0x7fffff) | 0x3f800000;
	tr_x = r;
	tr_y = r;
	tr_z = r;
	tr_w = r;
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "rget."^LD LFT^",r" is l_op7=0x40 & l_op11=0x43d & CLFTW & CLFTX & CLFTY & CLFTZ & LD & LFT & l_is=0 {
	tr_x = r;
	tr_y = r;
	tr_z = r;
	tr_w = r;
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "rinit r,"^l_fs^LFSF is l_op7=0x40 & l_op11=0x43e & LFSF & RLFSF & l_fs & l_ftf=0 & l_ft=0 {
	r = 0x3f800000 | (RLFSF & 0x7fffff);
}
LOWER: "rxor r,"^l_fs^LFSF is l_op7=0x40 & l_op11=0x43f & LFSF & RLFSF & l_fs & l_ftf=0 & l_ft=0 {
	r = 0x3f800000 | ((r ^ RLFSF) & 0x7fffff);
}
LOWER: "mfp."^LD LFT^",p" is l_op7=0x40 & l_op11=0x67c & CLFTW & CLFTX & CLFTY & CLFTZ & LD & LFT & l_is=0 {
	tr_x = p;
