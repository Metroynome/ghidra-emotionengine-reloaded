UF: "" is u_flags=0 { }
UF: "[t]" is u_flags=1 { }
UF: "[d]" is u_flags=2 { }
UF: "[dt]" is u_flags=3 { }
UF: "[m]" is u_flags=4 { }
UF: "[mt]" is u_flags=5 { }
