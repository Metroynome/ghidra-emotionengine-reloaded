	local r_w:4 = RLFSW;
	tr_x = r_x;
	tr_y = r_y;
	tr_z = r_z;
	tr_w = r_w;
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "mr32."^LD LFT^","^LFS is l_op7=0x40 & l_op11=0x33d & CLFTW & CLFTX & CLFTY & CLFTZ & LD & LFS & LFT & RLFSW & RLFSX & RLFSY & RLFSZ {
	local r_x:4 = RLFSY;
	local r_y:4 = RLFSZ;
	local r_z:4 = RLFSW;
	local r_w:4 = RLFSX;
	tr_x = r_x;
	tr_y = r_y;
	tr_z = r_z;
	tr_w = r_w;
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "lqi."^LD LFT^",("^IS^"++)" is l_op7=0x40 & l_op11=0x37c & CLFTW & CLFTX & CLFTY & CLFTZ & IS & LD & LFT & RIS & WIS {
	local qa:2 = (RIS) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = *[vumem]:4 (tr_ea + 0);
	tr_y = *[vumem]:4 (tr_ea + 4);
	tr_z = *[vumem]:4 (tr_ea + 8);
	tr_w = *[vumem]:4 (tr_ea + 12);
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
	WIS = RIS + 1;
}
LOWER: "sqi."^LD LFS^",("^IT^"++)" is l_op7=0x40 & l_op11=0x37d & CSTW & CSTX & CSTY & CSTZ & IT & LD & LFS & RIT & RLFSW & RLFSX & RLFSY & RLFSZ & WIT {
	local qa:2 = (RIT) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = RLFSX;
	tr_y = RLFSY;
	tr_z = RLFSZ;
	tr_w = RLFSW;
	build CSTX;
	build CSTY;
	build CSTZ;
	build CSTW;
	WIT = RIT + 1;
}
LOWER: "lqd."^LD LFT^",(--"^IS^")" is l_op7=0x40 & l_op11=0x37e & CLFTW & CLFTX & CLFTY & CLFTZ & IS & LD & LFT & RIS & WIS {
	local dec:2 = RIS - 1;
	WIS = dec;
	local qa:2 = (dec) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = *[vumem]:4 (tr_ea + 0);
	tr_y = *[vumem]:4 (tr_ea + 4);
	tr_z = *[vumem]:4 (tr_ea + 8);
	tr_w = *[vumem]:4 (tr_ea + 12);
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "sqd."^LD LFS^",(--"^IT^")" is l_op7=0x40 & l_op11=0x37f & CSTW & CSTX & CSTY & CSTZ & IT & LD & LFS & RIT & RLFSW & RLFSX & RLFSY & RLFSZ & WIT {
	local dec:2 = RIT - 1;
	WIT = dec;
	local qa:2 = (dec) & 0xff;
	tr_ea = zext(qa) * 16;
	tr_x = RLFSX;
	tr_y = RLFSY;
	tr_z = RLFSZ;
	tr_w = RLFSW;
	build CSTX;
	build CSTY;
	build CSTZ;
	build CSTW;
}
LOWER: "div q,"^l_fs^LFSF^","^l_ft^LFTF is l_op7=0x40 & l_op11=0x3bc & LFSF & LFTF & RLFSF & RLFTF & l_fs & l_ft {
	local num:4 = RLFSF;
	local den:4 = RLFTF;
	local dz:1 = (den & 0x7fffffff) == 0;
	local nz:1 = (num & 0x7fffffff) == 0;
	q = num f/ den;
	status = (status & 0xfcf) | (zext(dz && nz) << 4) | (zext(dz && !nz) << 5) | (zext(dz && nz) << 10) | (zext(dz && !nz) << 11);
}
LOWER: "sqrt q,"^l_ft^LFTF is l_op7=0x40 & l_op11=0x3bd & LFTF & RLFTF & l_ft & l_fsf=0 & l_fs=0 {
	local v:4 = RLFTF;
	q = sqrt(abs(v));
	status = (status & 0xfcf) | (zext((v s< 0) && ((v & 0x7fffffff) != 0)) << 4) | (zext(0:1) << 5) | (zext((v s< 0) && ((v & 0x7fffffff) != 0)) << 10) | (zext(0:1) << 11);
}
LOWER: "rsqrt q,"^l_fs^LFSF^","^l_ft^LFTF is l_op7=0x40 & l_op11=0x3be & LFSF & LFTF & RLFSF & RLFTF & l_fs & l_ft {
	local num:4 = RLFSF;
	local den:4 = RLFTF;
	local dz:1 = (den & 0x7fffffff) == 0;
	q = num f/ sqrt(abs(den));
	status = (status & 0xfcf) | (zext((den s< 0) && !dz) << 4) | (zext(dz) << 5) | (zext((den s< 0) && !dz) << 10) | (zext(dz) << 11);
}
LOWER: "waitq" is l_op7=0x40 & l_op11=0x3bf  & l_dest=0 & l_ft=0 & l_fs=0 {

}
LOWER: "mtir" IT^","^l_fs^LFSF is l_op7=0x40 & l_op11=0x3fc & IT & LFSF & RLFSF & WIT & l_fs & l_ftf=0 {
	WIT = RLFSF:2;
}
LOWER: "mfir."^LD LFT^","^IS is l_op7=0x40 & l_op11=0x3fd & CLFTW & CLFTX & CLFTY & CLFTZ & IS & LD & LFT & RIS {
	local iv:4 = sext(RIS);
	tr_x = iv;
	tr_y = iv;
	tr_z = iv;
	tr_w = iv;
	build CLFTX;
	build CLFTY;
	build CLFTZ;
	build CLFTW;
}
LOWER: "ilwr."^LD IT^",("^IS^")"^LD2 is l_op7=0x40 & l_op11=0x3fe & CILW & IS & IT & LD & LD2 & RIS {
	local qa:2 = (RIS) & 0xff;
