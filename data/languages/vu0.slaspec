UPPER: "itof12"^UF^"."^UD UFT^","^UFS is u_op11=0x13e & u_res=0 & UF & UD & CUFTW & CUFTX & CUFTY & CUFTZ & UFS & UFT {
	tr_x = int2float(us_x) f/ int2float(4096:4);
	tr_y = int2float(us_y) f/ int2float(4096:4);
	tr_z = int2float(us_z) f/ int2float(4096:4);
	tr_w = int2float(us_w) f/ int2float(4096:4);
	build CUFTX;
	build CUFTY;
	build CUFTZ;
	build CUFTW;
}
UPPER: "ftoi12"^UF^"."^UD UFT^","^UFS is u_op11=0x17e & u_res=0 & UF & UD & CUFTW & CUFTX & CUFTY & CUFTZ & UFS & UFT {
	tr_x = trunc(us_x f* int2float(4096:4));
	tr_y = trunc(us_y f* int2float(4096:4));
	tr_z = trunc(us_z f* int2float(4096:4));
	tr_w = trunc(us_w f* int2float(4096:4));
