LOWER: "ior" ID^","^IS^","^IT is l_op7=0x40 & l_op6=0x35 & ID & IS & IT & RIS & RIT & WID & l_dest=0 {
	WID = RIS | RIT;
}
LOWER: "move."^LD LFT^","^LFS is l_op7=0x40 & l_op11=0x33c & CLFTW & CLFTX & CLFTY & CLFTZ & LD & LFS & LFT & RLFSW & RLFSX & RLFSY & RLFSZ {
	local r_x:4 = RLFSX;
	local r_y:4 = RLFSY;
