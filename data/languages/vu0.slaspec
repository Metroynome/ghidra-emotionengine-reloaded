# Branches and jumps.
LB: "b" BTARG is l_op7=0x20 & BTARG & l_dest=0 & l_it=0 & l_is=0 {

 export BTARG;
}
LBAL: "bal" IT^","^BTARG is l_op7=0x21 & BTARG & IT & WIT & l_dest=0 & l_is=0 {
	local link:4 = inst_next >> 3;
	WIT = link:2;
 export BTARG;
}
LBC: "ibeq" IT^","^IS^","^BTARG is l_op7=0x28 & BTARG & IS & IT & RIS & RIT & l_dest=0 {
	lbr_cond = RIT == RIS;
 export BTARG;
}
LBC: "ibne" IT^","^IS^","^BTARG is l_op7=0x29 & BTARG & IS & IT & RIS & RIT & l_dest=0 {
	lbr_cond = RIT != RIS;
 export BTARG;
}
LBC: "ibltz" IS^","^BTARG is l_op7=0x2c & BTARG & IS & RIS & l_dest=0 & l_it=0 {
	lbr_cond = RIS s< 0;
 export BTARG;
}
LBC: "ibgtz" IS^","^BTARG is l_op7=0x2d & BTARG & IS & RIS & l_dest=0 & l_it=0 {
	lbr_cond = RIS s> 0;
