# Lower operands.
LFT: l_ft^LD is l_ft & LD { }
LFS: l_fs^LD is l_fs & LD { }
BTARG: dest is l_imm11 [ dest = inst_next + l_imm11 * 8; ] { export *:4 dest; }
IMM15: val is l_hi4 & l_lo11 [ val = (l_hi4 << 11) | l_lo11; ] { export *[const]:2 val; }
IMM12: val is l_bit21 & l_lo11 [ val = (l_bit21 << 11) | l_lo11; ] { export *[const]:2 val; }

# Lower instructions.
LOWER: "lq."^LD LFT^","^l_imm11^"("^IS^")" is l_op7=0x0 & IS & LD & LFT & l_imm11  { }
LOWER: "sq."^LD LFS^","^l_imm11^"("^IT^")" is l_op7=0x1 & IT & LD & LFS & l_imm11  { }
LOWER: "ilw."^LD IT^","^l_imm11^"("^IS^")"^LD2 is l_op7=0x4 & IS & IT & LD & LD2 & l_imm11  { }
LOWER: "isw."^LD IT^","^l_imm11^"("^IS^")"^LD2 is l_op7=0x5 & IS & IT & LD & LD2 & l_imm11  { }
LOWER: "iaddiu" IT^","^IS^","^IMM15 is l_op7=0x8 & IMM15 & IS & IT  { }
LOWER: "isubiu" IT^","^IS^","^IMM15 is l_op7=0x9 & IMM15 & IS & IT  { }
LOWER: "fceq vi01,"^l_imm24 is l_op7=0x10 & l_imm24 & l_b24=0 { }
LOWER: "fcset" l_imm24 is l_op7=0x11 & l_imm24 & l_b24=0 { }
LOWER: "fcand vi01,"^l_imm24 is l_op7=0x12 & l_imm24 & l_b24=0 { }
LOWER: "fcor vi01,"^l_imm24 is l_op7=0x13 & l_imm24 & l_b24=0 { }
LOWER: "fseq" IT^","^IMM12 is l_op7=0x14 & IMM12 & IT & l_hi3=0 & l_is=0 { }
LOWER: "fsset" IMM12 is l_op7=0x15 & IMM12 & l_hi3=0 & l_it=0 & l_is=0 & l_lo6=0 { }
LOWER: "fsand" IT^","^IMM12 is l_op7=0x16 & IMM12 & IT & l_hi3=0 & l_is=0 { }
LOWER: "fsor" IT^","^IMM12 is l_op7=0x17 & IMM12 & IT & l_hi3=0 & l_is=0 { }
LOWER: "fmeq" IT^","^IS is l_op7=0x18 & IS & IT & l_dest=0 & l_lo11=0 { }
LOWER: "fmand" IT^","^IS is l_op7=0x1a & IS & IT & l_dest=0 & l_lo11=0 { }
LOWER: "fmor" IT^","^IS is l_op7=0x1b & IS & IT & l_dest=0 & l_lo11=0 { }
