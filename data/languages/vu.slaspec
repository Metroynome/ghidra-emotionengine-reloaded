define register offset=0x2000 size=2 [ vi00 vi01 vi02 vi03 vi04 vi05 vi06 vi07 vi08 vi09 vi10 vi11 vi12 vi13 vi14 vi15 vi16 vi17 vi18 vi19 vi20 vi21 vi22 vi23 vi24 vi25 vi26 vi27 vi28 vi29 vi30 vi31 ];
define register offset=0x3000 size=4 [ q p i r status mac clip ];

define token instr(64)
	# Lower instruction (first word).
	l_word = (0,31)
	l_op7 = (25,31)
	l_dest = (21,24)
	l_ft = (16,20)
	l_fs = (11,15)
	l_fd = (6,10)
	l_it = (16,20)
	l_is = (11,15)
	l_id = (6,10)
	l_it4 = (16,19)
	l_is4 = (11,14)
	l_id4 = (6,9)
	l_ithi = (20,20)
	l_ishi = (15,15)
	l_idhi = (10,10)
	l_op6 = (0,5)
	l_op11 = (0,10)
	l_fsf = (21,22)
	l_ftf = (23,24)
	l_imm11 = (0,10) signed dec
	l_imm5 = (6,10) signed dec
	l_lo11 = (0,10)
	l_hi4 = (21,24)
	l_bit21 = (21,21)
	l_imm24 = (0,23) dec
	l_b24 = (24,24)
	l_hi3 = (22,24)
	l_lo6 = (0,5)
	# Upper instruction (second word).
	u_word = (32,63)
	u_flags = (59,63)
	u_i = (63,63)
	u_res = (57,58)
	u_dest = (53,56)
	u_ft = (48,52)
	u_fs = (43,47)
	u_fd = (38,42)
	u_op6 = (32,37)
	u_op4 = (34,37)
	u_bc = (32,33)
	u_op11 = (32,42)
;

attach variables [ l_ft l_fs l_fd u_ft u_fs u_fd ] [ vf00 vf01 vf02 vf03 vf04 vf05 vf06 vf07 vf08 vf09 vf10 vf11 vf12 vf13 vf14 vf15 vf16 vf17 vf18 vf19 vf20 vf21 vf22 vf23 vf24 vf25 vf26 vf27 vf28 vf29 vf30 vf31 ];
